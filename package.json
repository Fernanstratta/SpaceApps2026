{
  "name": "terranauta",
  "private": true,
  "version": "0.1.0",
  "description": "Terranauta: plataforma educativa para explorar la Tierra y la Luna.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "verify:data": "tsx scripts/verify-data.ts",
    "verify:i18n": "tsx scripts/verify-i18n.ts",
    "verify:mission": "tsx scripts/verify-mission.ts",
    "verify:lunita": "tsx scripts/verify-lunita.ts",
    "verify:preview": "tsx scripts/verify-preview.ts",
    "verify:playground": "tsx scripts/verify-playground.ts",
    "fetch:terrain": "tsx scripts/fetch-mission-terrain.ts"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-leaflet": "^5.0.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.20",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.0"
  }
}
